# Goal
bool plan
string[] frame_names
geometry_msgs/Pose[] frame_targets
builtin_interfaces/Duration duration
# move the arm at roughly 1/4 speed when true (default false = full speed)
bool slow_mode
# when true, each frame_target is an offset from that frame's current pose:
# position is added in the pelvis frame and orientation is pre-multiplied
# (pelvis-frame axes, about the frame's own origin). Default false = absolute.
bool relative
---
# Result
bool success
---
# Feedback
float32[] errors_linear
float32[] errors_angular
